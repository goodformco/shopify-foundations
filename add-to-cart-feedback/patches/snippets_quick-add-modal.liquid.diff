--- a/snippets/quick-add-modal.liquid
+++ b/snippets/quick-add-modal.liquid
@@ -29,6 +29,32 @@
   </dialog>
 </quick-add-dialog>
 
+{% comment %}
+  Skeleton for the quick add popup (Choose). quick-add.js shows it the moment Choose is tapped for a
+  product whose details aren't loaded yet, then the real details replace it. A generic shape: one
+  option row for any product, no matter how many options it has.
+{% endcomment %}
+<template id="quick-add-skeleton">
+  <div class="quick-add-skeleton__media" aria-hidden="true"></div>
+  <div class="quick-add-skeleton__details" aria-hidden="true">
+    <div class="quick-add-skeleton__header">
+      <span class="quick-add-skeleton__bar quick-add-skeleton__bar--title"></span>
+      <span class="quick-add-skeleton__bar quick-add-skeleton__bar--price"></span>
+    </div>
+    <div class="quick-add-skeleton__option">
+      <span class="quick-add-skeleton__bar quick-add-skeleton__bar--label"></span>
+      <div class="quick-add-skeleton__pills"><span></span><span></span><span></span></div>
+    </div>
+    <div class="quick-add-skeleton__footer">
+      <div class="quick-add-skeleton__buy">
+        <span class="quick-add-skeleton__quantity"></span>
+        <span class="quick-add-skeleton__button"></span>
+      </div>
+      <span class="quick-add-skeleton__button"></span>
+    </div>
+  </div>
+</template>
+
 {% render 'product-media-container-styles' %}
 {% render 'quick-add-modal-styles' %}
 {% render 'product-media-gallery-content-styles' %}
