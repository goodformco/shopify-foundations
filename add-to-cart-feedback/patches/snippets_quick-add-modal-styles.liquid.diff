+  /* Phone sheet: Horizon's desktop pinned buttons (sticky, solid background, soft fade above),
+     applied to the phone. The bottom padding moves from the scroll area onto the buttons, so the
+     resting gap under them is unchanged and stays covered while the details scroll. */
+  @media screen and (max-width: 749px) {
+    /* Uniform height: every product opens at exactly 60% of the screen, skeleton included.
+       Rows: 1 image + title/price (fixed at top), 2 options (the only part that scrolls, takes the
+       spare height), 3 buttons (fixed at the bottom). No sticky: in a grid, sticky can't leave its row. */
+    .quick-add-modal .quick-add-modal__content {
+      padding-block-end: 0;
+      height: 60dvh;
+      min-height: 60dvh;
+      grid-template-rows: auto minmax(0, 1fr) auto;
+    }
+
+    /* The panel itself doesn't scroll: a drag on any fixed part (image, title, buttons, edges) is
+       ignored instead of reaching the page behind, which made the browser bar reappear. Only the
+       options list (its own scroll container, below) still takes vertical drags. */
+    dialog.quick-add-modal,
+    .quick-add-modal .quick-add-modal__content {
+      touch-action: none;
+    }
+
+    /* Stock sets min-height: 0 on every child; the fixed rows must keep their full height */
+    .quick-add-modal .quick-add-modal__content > :not(variant-picker) {
+      min-height: auto;
+    }
+
+    .quick-add-modal__content variant-picker {
+      grid-row: 2;
+      display: block;
+      min-height: 0;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      touch-action: pan-y;
+      padding-block-end: var(--padding-3xl); /* last option row sits clear of the buttons */
+    }
+
+    .quick-add-skeleton__option {
+      grid-row: 2;
+      align-self: start;
+    }
+
+    .quick-add-modal__content > product-form-component,
+    .quick-add-skeleton__footer {
+      grid-row: 3;
+    }
+
+    /* Buttons: the old bottom padding split evenly above and below, with Horizon's soft fade
+       above them where the options scroll out of view */
+    .quick-add-modal__content > product-form-component {
+      position: relative;
+      margin-block-start: calc(var(--gap-lg) * -1); /* cancel the row gap: space above = space below */
+      padding-block: calc(var(--padding-xl) / 2);
+      background-color: var(--color-background);
+      z-index: var(--layer-raised);
+
+      &::before {
+        position: absolute;
+        content: '';
+        display: block;
+        inset: auto 0 100% 0;
+        pointer-events: none;
+        height: min(var(--gap-2xl), var(--gap));
+        background-color: inherit;
+        mask-image: linear-gradient(to top, #000 0%, #000 var(--gap-2xs), transparent 100%);
+      }
+    }
+
+    .quick-add-skeleton__footer {
+      margin-block-start: calc(var(--gap-lg) * -1);
+      padding-block: calc(var(--padding-xl) / 2);
+    }
+  }
