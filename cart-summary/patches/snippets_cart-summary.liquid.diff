+  /* Compact promo row (AG1-style). Outranks the duplicate '.cart-actions summary'
+     rules in cart-drawer.liquid and header-actions.liquid (44px min-height).
+     Still ~28px tall, above the 24px target-size minimum. */
+  .cart-actions .cart-discount__summary {
+    min-height: 0;
+    padding-block: var(--padding-2xs);
+  }
+
+  /* AG1-style promo field: Apply is an underlined text link inside the input */
+  .cart-discount__form {
+    position: relative;
+  }
+
+  .cart-discount__form .cart-discount__input {
+    padding-inline-end: calc(var(--padding-2xl) + var(--padding-md) + 3em);
+  }
+
+  .cart-discount__form .cart-discount__button {
+    position: absolute;
+    inset-inline-end: var(--padding-2xl);
+    height: auto;
+    color: var(--color-input-text);
+    font-size: var(--font-size--sm);
+    text-decoration: underline;
+    text-underline-offset: 0.2em;
+    cursor: pointer;
+    /* .button-unstyled clips overflow, which cut off the underline */
+    overflow: visible;
+  }
+
+  /* Muted until a code is typed */
+  .cart-discount__input:placeholder-shown + .cart-discount__button {
+    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
+  }
+
+  .cart-discount__note {
+    margin: 0;
+    padding-block-end: var(--padding-xs);
+    font-size: var(--font-size--xs);
+    color: var(--color-foreground-subdued);
+  }
+
