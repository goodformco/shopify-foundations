{%- doc -%}
  Compact "You may also like" product row for the cart drawer, shown below Clear all and above the summary.
  Products come from Theme settings > Cart > Product row collection (all products when none is picked),
  skipping unavailable products and products already in the cart. Uses Horizon's own product form and
  Add button, so adding refreshes the drawer the same way as any other add to cart.
  Products with more than one variant get a compact native dropdown (available variants only, first available
  preselected); assets/cart-upsell-variant.js keeps the Add form, price, image and links in sync with it.
  Products with a subscription get a Choose link to their product page instead.
{%- enddoc -%}

{%- liquid
  assign upsell_collection = settings.cart_drawer_upsell_collection
  if upsell_collection == blank
    assign upsell_collection = collections.all
  endif

  assign max_products = settings.cart_drawer_upsell_count | default: 6
  assign cart_product_ids = cart.items | map: 'product_id'
  assign shown = 0
  assign add_text = 'actions.add' | t
-%}

{%- capture upsell_items -%}
  {%- for product in upsell_collection.products -%}
    {%- if shown >= max_products -%}
      {%- break -%}
    {%- endif -%}
    {%- unless product.available -%}
      {%- continue -%}
    {%- endunless -%}
    {%- if cart_product_ids contains product.id -%}
      {%- continue -%}
    {%- endif -%}

    {%- liquid
      assign shown = shown | plus: 1
      assign variant = product.selected_or_first_available_variant

      assign can_add_directly = false
      if product.requires_selling_plan == false and product.selling_plan_groups.size == 0
        assign can_add_directly = true
      endif

      assign show_variant_picker = false
      if can_add_directly and product.variants_count > 1
        assign show_variant_picker = true
      endif

      if can_add_directly
        assign price = variant.price
      else
        assign price = product.price_min
      endif
      if settings.currency_code_enabled_cart_items
        assign price = price | money_with_currency
      else
        assign price = price | money
      endif
      if can_add_directly == false and product.price_varies
        assign price = 'content.price_from' | t: price: price
      endif

      assign image = variant.featured_image | default: product.featured_image
      assign upsell_form_id = 'CartUpsellProductForm-' | append: product.id
    -%}

    {%- capture upsell_card -%}
      <div class="cart-upsell__card{% if show_variant_picker %} cart-upsell__card--has-variant{% endif %}">
        <a
          href="{{ product.url }}"
          class="cart-upsell__media"
          tabindex="-1"
          aria-hidden="true"
        >
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 160
              | image_tag: class: 'cart-upsell__image', loading: 'lazy', alt: '', widths: '80, 160', sizes: '64px'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'cart-upsell__image' }}
          {%- endif -%}
        </a>

        <a
          href="{{ product.url }}"
          class="cart-upsell__title cart-primary-typography"
        >
          {{- product.title | escape -}}
        </a>

        {%- if show_variant_picker -%}
          <cart-upsell-variant class="cart-upsell__variant">
            <select
              class="cart-upsell__select cart-secondary-typography"
              aria-label="{{ 'content.variant' | t }}, {{ product.title | escape }}"
            >
              {%- for option_variant in product.variants -%}
                {%- unless option_variant.available -%}
                  {%- continue -%}
                {%- endunless -%}
                {%- liquid
                  if settings.currency_code_enabled_cart_items
                    assign option_price = option_variant.price | money_with_currency
                  else
                    assign option_price = option_variant.price | money
                  endif
                  assign option_image = option_variant.featured_image | default: product.featured_image
                -%}
                <option
                  value="{{ option_variant.id }}"
                  data-price="{{ option_price | escape }}"
                  data-quantity="{{ option_variant.quantity_rule.min | default: 1 }}"
                  data-url="{{ option_variant.url }}"
                  {% if option_image != blank %}
                    data-image-src="{{ option_image | image_url: width: 160 }}"
                    data-image-srcset="{{ option_image | image_url: width: 80 }} 80w, {{ option_image | image_url: width: 160 }} 160w"
                  {% endif %}
                  {% if option_variant.id == variant.id %}
                    selected
                  {% endif %}
                >
                  {{- option_variant.title | escape -}}
                </option>
              {%- endfor -%}
            </select>
            <svg
              aria-hidden="true"
              focusable="false"
              class="icon icon-caret"
              viewBox="0 0 10 6"
            >
              {%- render 'icon', icon: 'caret' -%}
            </svg>
          </cart-upsell-variant>
        {%- endif -%}

        <span class="cart-upsell__price cart-secondary-typography">{{ price }}</span>

        <div class="cart-upsell__action">
          {%- if can_add_directly -%}
            <product-form-component
              id="CartUpsellForm-{{ product.id }}"
              data-section-id="cart-drawer-section"
              data-product-id="{{ product.id }}"
              on:submit="/handleSubmit"
              class="cart-upsell__form"
            >
              <div
                class="visually-hidden"
                aria-live="assertive"
                role="status"
                aria-atomic="true"
                ref="liveRegion"
              ></div>
              {%- form 'product', product, id: upsell_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  ref="variantId"
                  value="{{ variant.id }}"
                >
                <input
                  type="hidden"
                  name="quantity"
                  value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
                >
                {% render 'add-to-cart-button',
                  add_to_cart_text: add_text,
                  class: 'add-to-cart-button button-secondary cart-upsell__add',
                  can_add_to_cart: variant.available,
                  show_icon: false,
                  product: product
                %}
              {%- endform -%}
            </product-form-component>
          {%- else -%}
            <a
              href="{{ product.url }}"
              class="button button-secondary cart-upsell__add"
            >
              {{- 'actions.choose' | t -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endcapture -%}
    {%- assign slide_index = shown | minus: 1 -%}
    {% render 'slideshow-slide', index: slide_index, children: upsell_card, class: 'cart-upsell__slide' %}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <section
    class="cart-upsell"
    aria-labelledby="CartUpsellHeading"
  >
    <h2
      id="CartUpsellHeading"
      class="cart-upsell__heading cart-secondary-typography"
    >
      {{- settings.cart_drawer_upsell_heading | escape -}}
    </h2>
    {% render 'slideshow',
      class: 'cart-upsell__carousel',
      slides: upsell_items,
      slide_count: shown,
      infinite: false,
      initial_slide: 0,
      show_arrows: false,
      slideshow_gutters: 'start end',
      attributes: 'in-viewport'
    %}
    {%- comment -%}
      in-viewport is rendered, not left to Horizon's viewport watcher: a cart refresh morphs this row in place and
      copies the server attributes, which strips the watcher's flag; the row didn't move, so it never came back
      and the row stayed locked (overflow: hidden) until it left and re-entered the screen.
    {%- endcomment -%}
  </section>

  {% render 'add-to-cart-button-styles' %}

  <style>
    /* Cart drawer product row. Own <style>: Horizon's stylesheet bundle stops rebuilding when large. */
    .cart-upsell {
      /* Clear all -> heading: generous break split in two (Clear all owns the first half),
         then heading, divider and cards grouped tightly */
      margin-block-start: var(--gap-lg);
      padding-block-end: var(--padding-2xl);
    }

    .cart-upsell__heading {
      margin: 0;
      padding-block-end: var(--padding-xs);
      font-size: var(--font-size--2xs);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    }

    /* Horizon's carousel; only spacing and card size are ours */
    .cart-upsell__carousel {
      --gutter-slide-width: var(--cart-drawer-padding, 0px);
      margin-block-start: var(--gap-sm);
      margin-inline: calc(-1 * var(--cart-drawer-padding, 0px));
    }

    .cart-upsell__carousel slideshow-slides {
      gap: var(--gap-sm);
      padding-block-end: var(--padding-xs);
      /* Reaching either end of the row must not hand the swipe on to the drawer (swipe to close) */
      overscroll-behavior-x: contain;
    }

    /* [aria-hidden] outranks Horizon's rule that blanks every card except the first */
    .cart-upsell__carousel slideshow-slide[aria-hidden] {
      --slide-width: 80%; /* next card peeks in */
      display: flex;
      scroll-snap-align: start;
      content-visibility: visible;
    }

    /* Same anchoring as the cart product rows: image top-left, title beside it at the top,
       price under the title, Add pinned bottom-right where the quantity selector sits. */
    .cart-upsell__card {
      display: grid;
      grid-template-columns: 4rem minmax(0, 1fr);
      grid-template-rows: min-content min-content 1fr;
      grid-template-areas:
        'media title'
        'media price'
        'media action';
      column-gap: var(--gap-sm);
      row-gap: var(--gap-3xs);
      width: 100%;
      padding: var(--padding-sm);
      border: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
      border-radius: {{ settings.cart_thumbnail_border_radius }}px;
    }

    /* Multi-variant card: dropdown sits between title and price */
    .cart-upsell__card--has-variant {
      grid-template-rows: min-content min-content min-content 1fr;
      grid-template-areas:
        'media title'
        'media variant'
        'media price'
        'media action';
    }

    .cart-upsell__variant {
      grid-area: variant;
      position: relative;
      display: flex;
      align-items: center;
      justify-self: start;
      max-width: 100%;
      margin-block: var(--gap-3xs);
      border: var(--style-border-width-inputs) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
      border-radius: var(--style-border-radius-inputs);
    }

    .cart-upsell__variant:hover {
      border-color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
    }

    /* Native select: one compact line, the browser/phone draws the open list */
    .cart-upsell__select {
      min-width: 0;
      max-width: 100%;
      margin: 0;
      padding-block: var(--padding-3xs);
      padding-inline: var(--padding-xs) calc(var(--padding-xs) + var(--icon-size-2xs) + var(--padding-2xs));
      appearance: none;
      background: transparent;
      border: 0;
      color: inherit;
      font-size: var(--font-size--xs);
      line-height: 1.5;
      text-overflow: ellipsis;
      cursor: pointer;
    }

    .cart-upsell__select:focus-visible {
      outline: var(--focus-outline-width) solid currentcolor;
      outline-offset: var(--focus-outline-offset);
    }

    .cart-upsell__variant .icon {
      position: absolute;
      inset-inline-end: var(--padding-xs);
      top: 50%;
      width: var(--icon-size-2xs);
      height: var(--icon-size-2xs);
      transform: translateY(-50%);
      pointer-events: none;
    }

    .cart-upsell__media {
      grid-area: media;
      align-self: start;
      display: block;
    }

    .cart-upsell__image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: {{ settings.cart_thumbnail_border_radius }}px;
    }

    .cart-upsell__title {
      grid-area: title;
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      font-size: var(--font-size--sm);
      line-height: 1.3;
      color: inherit;
      text-decoration: none;
    }

    .cart-upsell__price {
      grid-area: price;
      font-size: var(--font-size--sm);
    }

    .cart-upsell__action {
      grid-area: action;
      justify-self: end;
      align-self: end;
      margin-block-start: var(--gap-xs);
    }

    .cart-upsell .cart-upsell__add {
      min-height: 2rem;
      padding-block: 0;
      padding-inline: var(--padding-lg);
      font-size: var(--font-size--sm);
    }
  </style>
{%- endif -%}
